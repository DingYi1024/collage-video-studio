              "pause_start_s": 8.780834,
              "pause_end_s": 8.960834
            },
            {
              "text": "他拿到约两千两百万美元，",
              "boundary": "comma",
              "pause_after_s": 0.12,
              "units": 11,
              "safety_split": false,
              "start_s": 8.960834,
