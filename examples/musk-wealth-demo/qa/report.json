              "pause_start_s": 10.628167,
              "pause_end_s": 10.748166999999999
            },
            {
              "text": "却没有停手，而是继续押注互联网金融。",
              "boundary": "beat",
              "pause_after_s": 0.26,
              "units": 16,
              "safety_split": false,
              "start_s": 10.748166999999999,
              "speech_end_s": 13.413291999999998,
              "speech_duration_s": 2.665125,
              "pause_start_s": 13.413291999999998,
              "pause_end_s": 13.673291999999998
            },
            {
              "text": "PayPal 出售后，",
              "boundary": "comma",
